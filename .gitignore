# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/.next-e2e/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files (database password, Supabase key)
.env
.env.*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# migration artifacts
/migration-package/
/migration-package.previous/
*.migration.log

# runtime data: item images uploaded on the POS machine, and local backups
/public/uploads/
/backups/

# next-pwa generates these on every build
/public/sw.js
/public/sw.js.map
/public/workbox-*.js
/public/workbox-*.js.map

# IDE
.idea/

# test output
/playwright-report/
/test-results/
