{
  "name": "sunflower-crafts-pos",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 0.0.0.0",
    "build": "next build",
    "prestart": "node scripts/backup.js --on-start",
    "start": "next start -H 0.0.0.0",
    "postinstall": "prisma generate",
    "lint": "next lint",
    "typecheck": "tsc --noEmit -p .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm test",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:install": "playwright install chromium",
    "test:db:up": "node scripts/test-db.js up",
    "test:db:down": "node scripts/test-db.js down",
    "test:db:reset": "node scripts/test-db.js reset",
    "test:db:url": "node scripts/test-db.js url",
    "doctor": "node scripts/doctor.js",
    "backup": "node scripts/backup.js",
    "restore": "node scripts/restore-local-postgres.js",
    "uploads:check": "node scripts/uploads-check.js",
    "printer:list": "node scripts/printer.js list",
    "printer:test": "node scripts/printer.js test",
    "db:migrate": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "db:seed": "node scripts/seed.js",
    "migration:test": "vitest run tests/unit/migration-utils.test.ts",
    "migration:export": "node scripts/export-supabase-data.js",
    "migration:build": "node scripts/build-migration-package.js",
    "migration:restore": "node scripts/restore-local-postgres.js",
    "migrate:remote-images": "node scripts/migrate-remote-images.js"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "chart.js": "^4.4.4",
    "dotenv": "^17.4.2",
    "escpos": "^3.0.0-alpha.6",
    "escpos-usb": "^3.0.0-alpha.4",
    "lucide-react": "^0.441.0",
    "next": "^14.2.35",
    "next-pwa": "^5.6.0",
    "pg": "^8.16.3",
    "prisma": "^7.10.1",
    "react": "^18",
    "react-chartjs-2": "^5.2.0",
    "react-dom": "^18",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.2",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^8",
    "eslint-config-next": "^14.2.35",
    "postcss": "^8",
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.6",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "vitest": "^2.1.9",
    "webpack": "^5.94.0"
  },
  "allowScripts": {
    "@prisma/engines@7.10.1": true,
    "esbuild@0.21.5": true,
    "prisma@7.10.1": true,
    "sharp@0.33.5": true,
    "usb@1.9.2": true
  }
}
